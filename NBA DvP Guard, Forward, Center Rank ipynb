urn df\n","    except Exception as e:\n","        print(f\"Error fetching Opponent Stats for {position}: {e}\")\n","        return pd.DataFrame()\n","\n","# Fetch stats for Guards (G), Centers (C), and Forwards (F)\n","positions = ['G', 'C', 'F']\n","all_position_stats = []\n","\n","for pos in positions:\n","    df = fetch_opponent_stats_for_position(pos)\n","    if not df.empty:\n","        print(f\"\\nPreview of {pos} Stats (First 30 Rows):\")\n","        print(df.head(30))  # Show first 30 rows for readability\n","        all_position_stats.append(df)\n","\n","# Combine all data into a single DataFrame\n","if all_position_stats:\n","    combined_df = pd.concat(all_position_stats, ignore_index=True)\n","    print(\"\\n\" + \"=\"*50)\n","    print(\"Combined Opponent Stats for All Positions\")\n","    print(\"=\"*50)\n","    print(combined_df)  # Display the entire DataFrame\n","else:\n","    print(\"\\n\" + \"=\"*50)\n","    print(\"No data fetched for any position.\")\n","    print(\"=\"*50)\n","\n","# Step 1: Check which teams exist in all data\n","print(\"\\nStep 1: Checking Teams in All Data\")\n","all_teams = combined_df['TEAM_NAME'].unique()\n","print(\"Teams in All Data:\")\n","print(all_teams)\n","\n","# Step 2: Check which teams exist in the Centers data\n","print(\"\\nStep 2: Checking Teams in Centers Data\")\n","center_teams = combined_df[combined_df['Position'] == 'C']['TEAM_NAME'].unique()\n","print(\"Teams in Centers:\")\n","print(center_teams)\n","\n","# Step 3: Identify missing teams in Centers data\n","print(\"\\nStep 3: Identifying Missing Teams in Centers\")\n","missing_teams = set(all_teams) - set(center_teams)\n","print(\"Teams Missing from Centers:\")\n","print(missing_teams)\n","\n","# Step 4: Fetch raw data for Centers to debug\n","print(\"\\nStep 4: Fetching Raw Data for Centers\")\n","raw_center_stats = leaguedashteamstats.LeagueDashTeamStats(\n","    measure_type_detailed_defense='Opponent',\n","    per_mode_detailed='PerGame',\n","    player_position_abbreviation_nullable='C'\n",").get_data_frames()[0]\n","\n","print(\"Raw Data for Centers:\")\n","print(raw_center_stats)\n","\n","# Step 5: Compare across all positions\n","print(\"\\nStep 5: Comparing Across All Positions\")\n","diagnostic_df = combined_df.groupby(['TEAM_NAME', 'Position']).size().unstack(fill_value=0)\n","print(\"\\nPosition Breakdown by Team:\")\n","print(diagnostic_df)\n","\n","# Step 6: Manually extract Golden State Warriors data if missing\n","if 'Golden State Warriors' in set(all_teams) and 'Golden State Warriors' not in center_teams:\n","    print(\"\\nStep 6: Manually Extracting Golden State Warriors Data\")\n","    all_stats = leaguedashteamstats.LeagueDashTeamStats(\n","        measure_type_detailed_defense='Opponent',\n","        per_mode_detailed='PerGame'\n","    ).get_data_frames()[0]\n","\n","    warriors_data = all_stats[all_stats['TEAM_NAME'] == 'Golden State Warriors']\n","    print(\"\\nGolden State Warriors Data Across All Positions:\")\n","    print(warriors_data)\n","else:\n","    print(\"\\nGolden State Warriors are present in the Centers data.\")\n","\n","# Optional: Save the combined DataFrame to a CSV file\n","# combined_df.to_csv(\"opponent_stats_by_position.csv\", index=False)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FuWjsPgcXm1x","executionInfo":{"status":"ok","timestamp":1733422823265,"user_tz":300,"elapsed":1482,"user":{"displayName":"Scott Anderson","userId":"14836692437322607850"}},"outputId":"079b626e-8bed-4768-a408-f51db1fecae4"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n","Fetching Opponent Stats for Position: G\n","==================================================\n","Successfully fetched 30 rows for position: G\n","\n","Preview of G Stats (First 30 Rows):\n","       TEAM_ID               TEAM_NAME  GP   W   L  W_PCT   MIN  OPP_FGM  OPP_FGA  OPP_FG_PCT  OPP_FG3M  OPP_FG3A  OPP_F